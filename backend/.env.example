PORT=4000
NODE_ENV=development

# REQUIRED in production – app fails fast if missing in prod
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=2h

# Bcrypt cost factor
BCRYPT_ROUNDS=10

# Demo user passwords (plain text – hashed at boot)
ADMIN_PASSWORD=Admin@123
ORGANISER_PASSWORD=Organiser@123
VIEWER_PASSWORD=Viewer@123

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Event capacity (overrides data/event.json if set)
# EVENT_CAPACITY=50

# Rate limits (per window)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_CHECKIN=20
RATE_LIMIT_SEARCH=60
RATE_LIMIT_GLOBAL=200
